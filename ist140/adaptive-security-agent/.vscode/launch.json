{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Agent (Guided)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/agent.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug Agent (Config Dry Run)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/agent.py",
      "args": [
        "run",
        "--config",
        "${workspaceFolder}/config.json"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug Memory Search",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/agent.py",
      "args": [
        "memory-search",
        "--config",
        "${workspaceFolder}/config.json",
        "--query",
        "timeout"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
